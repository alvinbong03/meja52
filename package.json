{
  "name": "meja52",
  "private": true,
  "version": "1.0.0",
  "description": "A premium, account-free digital poker-chip table for in-person games.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "wrangler dev -c worker/wrangler.jsonc --port 8787",
    "dev:web": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "test": "npm run test:unit && npm run test:worker",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:worker": "vitest run --config worker/vitest.config.ts",
    "test:e2e": "playwright test",
    "deploy": "npm run build && wrangler deploy -c worker/wrangler.jsonc",
    "deploy:dry-run": "npm run build && wrangler deploy -c worker/wrangler.jsonc --dry-run",
    "smoke:live": "node scripts/smoke-live.mjs",
    "shots": "node e2e/shots.mjs",
    "assets": "node scripts/assets.mjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260914.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.131.1"
  },
  "engines": {
    "node": ">=22"
  }
}
