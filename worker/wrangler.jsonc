{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "meja52",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "assets": {
    "directory": "../dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "ratelimits": [
    { "name": "CREATE_LIMITER", "namespace_id": "4201", "simple": { "limit": 20, "period": 60 } },
    { "name": "LOOKUP_LIMITER", "namespace_id": "4202", "simple": { "limit": 60, "period": 60 } },
    { "name": "CONNECT_LIMITER", "namespace_id": "4203", "simple": { "limit": 60, "period": 60 } }
  ]
}
